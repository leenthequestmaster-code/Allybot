NODE_ENV=production
LOG_LEVEL=info
DATABASE_PATH=./data/allyssea.sqlite
AUTH_ACCOUNT_ID=primary
# Local Baileys recovery cache: bounded technical cache, not permanent chat history.
LOCAL_MESSAGE_CACHE_TTL_MS=86400000
LOCAL_MESSAGE_CACHE_MAX_ROWS=10000
LOCAL_MESSAGE_CACHE_MAX_BYTES=67108864
QR_ENABLED=true
PAIRING_ENABLED=false
# PAIRING_PHONE_NUMBER=628xxxxxxxxxx
ENABLE_HISTORY_SYNC=false
MAX_RECONNECT_DELAY_MS=300000
SHUTDOWN_TIMEOUT_MS=15000
COMMAND_PREFIX=!
DEFAULT_COMMAND_COOLDOWN_MS=3000
DIAGNOSTICS_ENABLED=false
XKIRO_AI_ENABLED=false
XKIRO_AI_FALLBACK_ENABLED=false
XKIRO_API_KEY=

# Optional PostgreSQL connection-only verification; this does not replace SQLite DATABASE_PATH.
# POSTGRES_URL=postgresql://<user>:<password>@<host>:5432/postgres
POSTGRES_POOL_MODE=session
# POSTGRES_MONITOR_INTERVAL_MS=300000
# POSTGRES_MONITOR_TIMEOUT_MS=15000

# Supabase Economy authoritative read path; server-side only, never expose the service-role key.
# SUPABASE_ECONOMY_ENABLED=false
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<server-only-secret-key>
# SUPABASE_ECONOMY_CACHE_TTL_SECONDS=15
# Character Sheet dan Group Context memakai client service-role yang sama, tetapi tetap feature-gated.
# CHARACTER_GUIDE_ENABLED=false
# GROUP_CONTEXT_ENABLED=false
# CHARACTER_GUIDE_SESSION_TTL_SECONDS=1800
# GROUP_CONTEXT_OOC_COOLDOWN_MS=30000
# GROUP_CONTEXT_OOC_WINDOW_MS=600000
# GROUP_CONTEXT_OOC_MAX_PER_WINDOW=3

# Optional Upstash Redis cache/rate-limit. Redis bukan authority Character atau Economy.
# UPSTASH_REDIS_ENABLED=false
# UPSTASH_REDIS_REST_URL=https://<database>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<server-only-secret-token>
# UPSTASH_REDIS_TIMEOUT_MS=5000
# UPSTASH_REDIS_OPERATION_TIMEOUT_MS=1000
# UPSTASH_REDIS_MAX_ATTEMPTS=2
# UPSTASH_REDIS_RETRY_DELAY_MS=100
# UPSTASH_REDIS_KEY_PREFIX=allybot:v1

# Optional separate Neon PostgreSQL client; capture is not implemented by this initialization slice.
# NEON_ENABLED=false
# NEON_DATABASE_URL=<paste-the-Neon-connection-string-only-in-server-environment>
# Supply the password through the actual server-side secret value, never in source control.
# NEON_POOL_MODE=transaction
# NEON_CHAT_LOG_ENABLED=false
# NEON_CHAT_LOG_GROUPS=<comma-separated-group-jids-approved-for-capture>
# NEON_CHAT_LOG_QUEUE_CAPACITY=1000
# NEON_CHAT_LOG_MAX_ATTEMPTS=3
# NEON_CHAT_LOG_RETRY_DELAY_MS=250
# NEON_CHAT_LOG_MAX_RETRY_DELAY_MS=5000
# NEON_CHAT_LOG_WRITE_TIMEOUT_MS=10000
# NEON_CHAT_LOG_DRAIN_TIMEOUT_MS=10000

# Optional developer-only delivery of the latest sanitized Codebase Intelligence Export.
# The ZIP is generated by CI and never scanned or generated by the production bot.
CODEBASE_EXPORT_ENABLED=false
CODEBASE_EXPORT_PATH=./Codebase/allybot-codebase-latest.zip
CODEBASE_EXPORT_MAX_BYTES=3145728
# Optional privacy-minimized Sentry telemetry. Keep the DSN server-side only.
SENTRY_ENABLED=false
# SENTRY_DSN=https://<project-key>@<region>.ingest.sentry.io/<project-id>
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=<commit-sha>
SENTRY_TRACES_SAMPLE_RATE=0
