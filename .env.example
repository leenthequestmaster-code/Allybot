NODE_ENV=production
LOG_LEVEL=info
DATABASE_PATH=./data/allyssea.sqlite
AUTH_ACCOUNT_ID=primary
# Local Baileys recovery cache: bounded technical cache, not permanent chat history.
LOCAL_MESSAGE_CACHE_TTL_MS=86400000
LOCAL_MESSAGE_CACHE_MAX_ROWS=10000
LOCAL_MESSAGE_CACHE_MAX_BYTES=67108864
QR_ENABLED=true
PAIRING_ENABLED=false
# PAIRING_PHONE_NUMBER=628xxxxxxxxxx
ENABLE_HISTORY_SYNC=false
MAX_RECONNECT_DELAY_MS=300000
SHUTDOWN_TIMEOUT_MS=15000
COMMAND_PREFIX=!
DEFAULT_COMMAND_COOLDOWN_MS=3000
DIAGNOSTICS_ENABLED=false
XKIRO_AI_ENABLED=false
XKIRO_AI_FALLBACK_ENABLED=false
XKIRO_API_KEY=

# MongoDB database layer (character guide, group context, economy)
# MONGODB_ENABLED=false
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DATABASE=allybot

# Redis caching, rate-limiting, and coordination layer
# REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=allybot:v1

# Character Guide and Group Context features
# CHARACTER_GUIDE_ENABLED=false
# GROUP_CONTEXT_ENABLED=false
# CHARACTER_GUIDE_SESSION_TTL_SECONDS=1800
# GROUP_CONTEXT_OOC_COOLDOWN_MS=30000
# GROUP_CONTEXT_OOC_WINDOW_MS=600000
# GROUP_CONTEXT_OOC_MAX_PER_WINDOW=3

# Optional developer-only delivery of the latest sanitized Codebase Intelligence Export.
CODEBASE_EXPORT_ENABLED=false
CODEBASE_EXPORT_PATH=./Codebase/allybot-codebase-latest.zip
CODEBASE_EXPORT_MAX_BYTES=3145728

# Optional privacy-minimized Sentry telemetry. Keep the DSN server-side only.
SENTRY_ENABLED=false
# SENTRY_DSN=https://<project-key>@<region>.ingest.sentry.io/<project-id>
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=<commit-sha>
SENTRY_TRACES_SAMPLE_RATE=0
