{
  "name": "allybot",
  "version": "0.1.0",
  "private": true,
  "description": "Allybot WhatsApp core foundation",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "self-check": "node dist/index.js --self-check",
    "verify:platform": "node scripts/verify-platform.mjs",
    "export": "node scripts/generate-codebase-export.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "node --test tests/*.test.js",
    "knip": "knip"
  },
  "dependencies": {
    "@cacheable/node-cache": "1.7.5",
    "@cedricdsst/twitter-video-downloader": "^0.1.0",
    "@modernized/fluent-ffmpeg": "^1.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "10.71.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "@zenaveline/scraper": "^1.4.9",
    "@zibot/scdl": "^0.1.6",
    "better-sqlite3": "12.4.1",
    "cheerio": "^1.2.0",
    "chrono-node": "^2.10.3",
    "dotenv": "17.2.1",
    "exifr": "^7.1.3",
    "file-type": "^21.0.0",
    "gerdur-core": "^2.20.0",
    "ioredis": "^6.0.0",
    "jsqr": "^1.4.0",
    "lrclib-api": "^2.2.0",
    "music-metadata": "^11.10.3",
    "node-id3": "^0.2.9",
    "openai": "^7.25.0",
    "pdf-lib": "^1.17.1",
    "pino": "9.9.0",
    "playwright": "^1.64.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "0.12.0",
    "satori": "^0.33.5",
    "sharp": "^0.35.5",
    "skia-canvas": "^4.0.0",
    "suncalc": "^2.1.1",
    "ultra-igdl": "^1.0.3",
    "youtube-sr": "^4.3.12",
    "zod": "^4.6.5"
  },
  "overrides": {
    "sharp": "$sharp",
    "fflate": "0.7.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/suncalc": "^1.9.2",
    "knip": "^6.43.0",
    "typescript": "5.9.2",
    "vitest": "^5.0.5"
  }
}
