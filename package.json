{
  "name": "allybot",
  "version": "0.1.0",
  "private": true,
  "description": "Allybot WhatsApp core foundation",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "mkdir -p dist/assets && cp assets/allybot-menu-thumbnail.jpg dist/assets/allybot-menu-thumbnail.jpg",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "self-check": "node dist/index.js --self-check",
    "verify:platform": "node scripts/verify-platform.mjs",
    "export": "node scripts/generate-codebase-export.mjs",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@cacheable/node-cache": "1.7.5",
    "@sentry/node": "10.71.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "12.4.1",
    "dotenv": "17.2.1",
    "ioredis": "^6.0.0",
    "mongodb": "^7.6.0",
    "openai": "7.5.0",
    "pino": "9.9.0",
    "qrcode-terminal": "0.12.0",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  }
}
