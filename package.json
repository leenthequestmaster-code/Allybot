{
  "name": "allybot",
  "version": "0.1.0",
  "private": true,
  "description": "Allybot WhatsApp core foundation",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "self-check": "node dist/index.js --self-check",
    "verify:platform": "node scripts/verify-platform.mjs",
    "verify:postgres": "node scripts/verify-postgres.mjs",
    "verify:supabase-access": "node scripts/verify-supabase-access.mjs",
    "verify:neon": "node scripts/verify-neon.mjs",
    "verify:neon-schema": "node scripts/verify-neon-chat-log-migration.mjs",
    "verify:upstash-redis": "node scripts/verify-upstash-redis.mjs",
    "verify:supabase-character": "node scripts/verify-supabase-character-migration.mjs .",
    "monitor:postgres": "node scripts/monitor-postgres.mjs",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@cacheable/node-cache": "1.7.5",
    "@supabase/supabase-js": "2.112.3",
    "@upstash/redis": "1.38.2",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "12.4.1",
    "dotenv": "17.2.1",
    "openai": "7.5.0",
    "pino": "9.9.0",
    "postgres": "3.4.9",
    "qrcode-terminal": "0.12.0",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  }
}
