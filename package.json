{
  "name": "allybot",
  "version": "0.1.0",
  "private": true,
  "description": "Allybot WhatsApp core foundation",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "mkdir -p dist/assets dist/web && cp assets/allybot-menu-thumbnail.jpg dist/assets/allybot-menu-thumbnail.jpg && cp src/web/index.html dist/web/index.html",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "self-check": "node dist/index.js --self-check",
    "verify:platform": "node scripts/verify-platform.mjs",
    "export": "node scripts/generate-codebase-export.mjs",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@cacheable/node-cache": "1.7.5",
    "@cedricdsst/twitter-video-downloader": "^0.1.0",
    "@renpwn/fb-downloader": "^1.0.16",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "10.71.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "@zenaveline/scraper": "^1.4.9",
    "@zibot/scdl": "^0.1.6",
    "better-sqlite3": "12.4.1",
    "dotenv": "17.2.1",
    "gerdur-core": "^2.20.0",
    "ioredis": "^6.0.0",
    "lrclib-api": "^2.2.0",
    "openai": "^7.25.0",
    "p-limit": "^7.3.3",
    "pino": "9.9.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "0.12.0",
    "satori": "^0.33.5",
    "sharp": "^0.35.5",
    "ultra-igdl": "^1.0.3",
    "youtube-sr": "^4.3.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.3.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "5.9.2"
  }
}
